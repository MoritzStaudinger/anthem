Bootstrap: docker
From: python:3.11-slim

%labels
    Author Moritz Staudinger
    Purpose ACL PDF parsers (OCR + PyMuPDF)

%environment
    PYTHONUNBUFFERED=1
    PIP_DISABLE_PIP_VERSION_CHECK=1

%post
    set -e
    apt-get update
    # Tesseract OCR (eng + deu as examples; add more packs if needed)
    apt-get install -y --no-install-recommends \
        tesseract-ocr tesseract-ocr-eng tesseract-ocr-deu \
        libtesseract-dev libleptonica-dev \
        poppler-utils \
        git ca-certificates curl
    rm -rf /var/lib/apt/lists/*

    pip install --no-cache-dir \
        pymupdf==1.24.10 \
        pytesseract==0.3.13 \
        pillow==10.4.0 \
        lxml==5.3.0 \
        pandas==2.2.2 \
        numpy==1.26.4 \
        tqdm==4.66.4

    mkdir -p /app /work /logs

%files
    scripts/ocr_mapper.py /app/ocr_mapper.py
    scripts/pymu_parser.py /app/pymu_parser.py

%runscript
    echo "Parsers container. Use: python /app/ocr_mapper.py or /app/pymu_parser.py"
    exec bash
